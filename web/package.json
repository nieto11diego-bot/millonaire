{
  "name": "millionaire-city-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-game": "node scripts/sync-game.mjs",
    "watch-game": "node scripts/watch-game.mjs",
    "dev": "npm run sync-game && concurrently -k -n game,next -c cyan,magenta \"npm run watch-game\" \"next dev\"",
    "dev:next": "next dev",
    "build": "npm run sync-game && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.0",
    "typescript": "^5.8.2"
  }
}
